
class Vehicle {
    private String vehicleNo;
    private Integer duration;
    private Integer slotNo;

    public Vehicle(String vehicleNo, int duration, int slotNo) {
        setVehicleNo(vehicleNo);
        setDuration(duration);
        setSlotNo(slotNo);
    }

    public String getVehicleNo() {
        return vehicleNo;
    }

    public void setVehicleNo(String vehicleNo) {
        if (vehicleNo == null || vehicleNo.trim().isEmpty()) {
            throw new IllegalArgumentException(
                "Vehicle number cannot be empty");
        }
        this.vehicleNo = vehicleNo;
    }

    public Integer getDuration() {
        return duration;
    }

    public void setDuration(Integer duration) {
        if (duration == null || duration < 0) {
            throw new IllegalArgumentException(
                "Duration cannot be negative or null");
        }
        this.duration = duration;
    }

    public Integer getSlotNo() {
        return slotNo;
    }

    public void setSlotNo(Integer slotNo) {
        if (slotNo == null || slotNo < 1) {
            throw new IllegalArgumentException(
                "Slot number must be positive");
        }
        this.slotNo = slotNo;
    }

    public double calculateFee() {
        return duration * 30.0;
    }
}

public class Main {
    public static void main(String[] args) {
        Vehicle v = new Vehicle("TN01A1", 2, 5);

        System.out.println("Vehicle Number: "
                + v.getVehicleNo());
        System.out.println("Duration: "
                + v.getDuration() + " hours");
        System.out.println("Slot Number: "
                + v.getSlotNo());
        System.out.println("Parking Fee: Rs. "
                + v.calculateFee());

        // Uncomment to test validation:
        // v.setDuration(-2);
    }
}
