import java.util.Objects;

public class Task07 {

    static class Vehicle {
        private final String regNo;

        Vehicle(String regNo) {
            this.regNo = regNo;
        }

        public final String getRegNo() {
            return regNo;
        }

        public double calculateFee(int hours) {
            return 0.0;
        }

        @Override
        public String toString() {
            return "Vehicle{regNo='" + regNo + "'}";
        }

        @Override
        public boolean equals(Object obj) {
            if (this == obj)
                return true;

            if (!(obj instanceof Vehicle))
                return false;

            Vehicle other = (Vehicle) obj;
            return regNo.equals(other.regNo);
        }

        @Override
        public int hashCode() {
            return Objects.hash(regNo);
        }
    }

    static class TwoWheeler extends Vehicle {
        TwoWheeler(String regNo) {
            super(regNo);
        }

        @Override
        public double calculateFee(int hours) {
            return hours * 10.0;
        }
    }

    static class Car extends Vehicle {
        Car(String regNo) {
            super(regNo);
        }

        @Override
        public double calculateFee(int hours) {
            return hours * 30.0;
        }
    }

    static class ElectricCar extends Vehicle {
        ElectricCar(String regNo) {
            super(regNo);
        }

        @Override
        public double calculateFee(int hours) {
            return hours * 30.0 + 20.0;
        }
    }

    public static void main(String[] args) {
        Vehicle v1 = new TwoWheeler("TN01A1");
        Vehicle v2 = new Car("TN02B2");
        Vehicle v3 = new TwoWheeler("TN01A1");
        Vehicle v4 = new ElectricCar("TN03C3");

        System.out.println(v1);
        System.out.println("TwoWheeler Fee: Rs. "
                + v1.calculateFee(3));
        System.out.println("Car Fee: Rs. "
                + v2.calculateFee(3));
        System.out.println("ElectricCar Fee: Rs. "
                + v4.calculateFee(3));

        System.out.println("Same Registration: "
                + v1.equals(v3));
        System.out.println("Same Hash Code: "
                + (v1.hashCode() == v3.hashCode()));
    }
}
