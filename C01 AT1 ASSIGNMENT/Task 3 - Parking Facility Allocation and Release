import java.util.Arrays;
public class Task03 {

    static class ParkingFacility {
        String[][] slots;

        ParkingFacility(int[] floorSizes) {
            slots = new String[floorSizes.length][];

            for (int i = 0; i < floorSizes.length; i++) {
                slots[i] = new String[floorSizes[i]];
            }
        }

        int[] allocate(String vehicleNo) {
            for (int i = 0; i < slots.length; i++) {
                for (int j = 0; j < slots[i].length; j++) {
                    if (slots[i][j] == null) {
                        slots[i][j] = vehicleNo;
                        return new int[]{i, j};
                    }
                }
            }
            return null;
        }

        boolean release(int floor, int slot) {
            if (floor < 0 || floor >= slots.length ||
                slot < 0 || slot >= slots[floor].length ||
                slots[floor][slot] == null) {
                return false;
            }

            slots[floor][slot] = null;
            return true;
        }
    }

    public static void main(String[] args) {
        ParkingFacility parking =
                new ParkingFacility(new int[]{2, 1});

        System.out.println(Arrays.toString(parking.allocate("TN01A1")));
        System.out.println(Arrays.toString(parking.allocate("TN02B2")));
        System.out.println(Arrays.toString(parking.allocate("TN03C3")));
        System.out.println(parking.allocate("TN04D4"));

        System.out.println(
            parking.release(0, 1) + " " +
            parking.release(0, 1) + " " +
            parking.release(5, 0)
        );

        System.out.println(Arrays.toString(parking.allocate("TN04D4")));
    }
}
