import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter number of floors: ");
        int floors = sc.nextInt();

        int[][] slots = new int[floors][];

        for (int f = 0; f < floors; f++) {
            System.out.print("Slots on floor " + f + ": ");
            int count = sc.nextInt();
            slots[f] = new int[count];
        }

        int minutes = 130;

        int wrongHours = minutes / 60;
        int billableHours = (minutes + 59) / 60;

        System.out.println("Wrong integer hours: " + wrongHours);
        System.out.println("Billable hours: " + billableHours);
        System.out.println("Fee at Rs.30/hour: Rs." + (billableHours * 30));
        System.out.println("Floors created: " + slots.length);

        sc.close();
    }
}
